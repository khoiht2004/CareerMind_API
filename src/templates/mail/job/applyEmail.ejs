<div
  style="font-family:sans-serif;max-width:480px;margin:0 auto;padding:32px 24px;background:#fff;border-radius:12px;border:1px solid #e5e7eb">
  <div style="text-align:center;margin-bottom:24px">
    <div style="display:inline-block;background:#111;color:#fff;font-weight:700;padding:8px 16px;border-radius:8px;font-size:14px">
      SRA
    </div>
  </div>
  <h2 style="font-size:20px;font-weight:700;margin:0 0 8px">Ứng tuyển thành công</h2>
  <p style="color:#6b7280;font-size:14px;margin:0 0 16px">Chào <%= applicantName %>,</p>
  <p style="color:#6b7280;font-size:14px;margin:0 0 24px">Hồ sơ ứng tuyển của bạn cho vị trí
    <strong><%= jobTitle %></strong> tại <strong><%= company %></strong> đã được hệ thống tiếp nhận.
  </p>
  <p style="color:#6b7280;font-size:14px;margin:0 0 24px">Chúng tôi sẽ xem xét và phản hồi cho bạn trong thời gian sớm
    nhất.
  </p>
  <p style="color:#6b7280;font-size:13px;margin:0">Trân trọng,<br />Đội ngũ <%= company %></p>
</div>