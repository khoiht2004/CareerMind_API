<div style="font-family:'Inter', sans-serif;max-width:480px;margin:0 auto;padding:40px 32px;background:#fff;border-radius:24px;border:1px solid #e8e8e8;box-shadow:0 8px 30px rgba(0,0,0,0.04)">
  <div style="text-align:center;margin-bottom:32px">
    <div style="display:inline-block;background:#00b14f;color:#fff;font-weight:800;padding:8px 16px;border-radius:12px;font-size:18px;letter-spacing:-0.5px">topcv</div>
  </div>
  
  <h2 style="font-size:22px;font-weight:700;margin:0 0 16px;color:#181c20;text-align:center">Ứng tuyển thành công</h2>
  <p style="color:#5f6368;font-size:15px;margin:0 0 16px;line-height:1.6">Chào <strong style="color:#181c20"><%= applicantName %></strong>,</p>
  
  <p style="color:#5f6368;font-size:15px;margin:0 0 16px;line-height:1.6">
    Hồ sơ ứng tuyển của bạn cho vị trí <strong style="color:#181c20"><%= jobTitle %></strong> tại <strong style="color:#181c20"><%= company %></strong> đã được hệ thống tiếp nhận thành công.
  </p>
  
  <div style="background:#e7f3ff;border:1px solid #b7d8f5;border-radius:16px;padding:20px;margin:0 0 32px">
    <p style="color:#195f97;font-size:14px;margin:0;line-height:1.6;text-align:center">
      Chúng tôi sẽ tiến hành xem xét hồ sơ và phản hồi lại kết quả cho bạn trong thời gian sớm nhất.
    </p>
  </div>
  
  <p style="color:#5f6368;font-size:14px;margin:0;line-height:1.5">Trân trọng,<br /><strong style="color:#181c20">Đội ngũ <%= company %></strong></p>
</div>