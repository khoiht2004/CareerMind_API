<div style="font-family:'Inter', sans-serif;max-width:480px;margin:0 auto;padding:40px 32px;background:#fff;border-radius:24px;border:1px solid #e8e8e8;box-shadow:0 8px 30px rgba(0,0,0,0.04)">
  <div style="text-align:center;margin-bottom:32px">
    <div style="display:inline-block;background:#00b14f;color:#fff;font-weight:800;padding:8px 16px;border-radius:12px;font-size:18px;letter-spacing:-0.5px">topcv</div>
  </div>

  <div style="text-align:center;margin-bottom:24px">
    <span style="display:inline-block;background:#e7f8ed;color:#1b6a41;font-weight:700;font-size:13px;padding:6px 16px;border-radius:9999px;border:1px solid #b8e1c7;letter-spacing:0.3px">
       LỊCH PHỎNG VẤN
    </span>
  </div>

  <h2 style="font-size:22px;font-weight:700;margin:0 0 16px;color:#181c20;text-align:center">Thư mời phỏng vấn</h2>
  <p style="color:#5f6368;font-size:15px;margin:0 0 16px;line-height:1.6">Chào <strong style="color:#181c20"><%= applicantName %></strong>,</p>

  <p style="color:#5f6368;font-size:15px;margin:0 0 24px;line-height:1.6">
    Cảm ơn bạn đã ứng tuyển vị trí <strong style="color:#181c20"><%= jobTitle %></strong> tại <strong style="color:#181c20"><%= company %></strong>. Hồ sơ của bạn rất ấn tượng và chúng tôi trân trọng mời bạn tham gia một buổi phỏng vấn.
  </p>

  <div style="background:#f1f4fa;border:1px solid #e8e8e8;border-radius:16px;padding:20px 24px;margin:0 0 24px">
    <table style="width:100%;border-collapse:collapse;font-size:14px">
      <tr>
        <td style="padding:8px 0;color:#5f6368;width:35%">Ngày</td>
        <td style="padding:8px 0;font-weight:600;color:#181c20"><%= interviewDateFormat %></td>
      </tr>
      <tr>
        <td style="padding:8px 0;color:#5f6368">Thời gian</td>
        <td style="padding:8px 0;font-weight:600;color:#181c20"><%= interviewTime %></td>
      </tr>
      <tr>
        <td style="padding:8px 0;color:#5f6368">Hình thức</td>
        <td style="padding:8px 0;font-weight:600;color:#181c20"><%= formatInterview %></td>
      </tr>
      <tr>
        <td style="padding:8px 0;color:#5f6368;vertical-align:top">Địa điểm/Link</td>
        <td style="padding:8px 0;font-weight:600;color:#181c20;line-height:1.5"><%= interviewLocation %></td>
      </tr>
    </table>
  </div>

  <div style="background:#fff7d1;border:1px solid #f0df9a;border-radius:12px;padding:16px;margin:0 0 32px">
    <p style="color:#8a6a00;font-size:14px;margin:0;line-height:1.5;text-align:center">
      Vui lòng xác nhận tham dự hoặc yêu cầu đổi lịch trước <strong style="color:#5e4800"><%= confirmDeadlineFormat %></strong> bằng cách trả lời lại email này.
    </p>
  </div>

  <p style="color:#5f6368;font-size:14px;margin:0;line-height:1.5">Trân trọng,<br /><strong style="color:#181c20">Đội ngũ Tuyển dụng — <%= company %></strong></p>
</div>