model User {
  id                    String           @id @default(uuid())
  email                 String           @unique @map("email")
  password              String           @map("password")
  role                  Role             @default(CANDIDATE) @map("role")
  isVerified            Boolean          @default(false) @map("is_verified")
  isActive              Boolean          @default(true) @map("is_active")
  verificationCode      String?          @map("verification_code") @db.VarChar(6)
  verificationCodeExpAt DateTime?        @map("verification_code_exp_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  companyId             String?          @map("company_id")
  canCompanyManage      Boolean          @default(false) @map("can_company_manage")
  applications          Application[]
  chatSessions          ChatSession[]
  coverLetters          CoverLetter[]
  cvs                   Cv[]
  postedJobs            Job[]
  posts                 Post[]
  profile               Profile?
  refreshTokens         RefreshToken[]
  revokedTokens         RevokedToken[]
  savedJobs             SavedJob[]
  companyReviews        CompanyReview[]
  company               Company?         @relation(fields: [companyId], references: [id])
  userPermissions       UserPermission[]

  @@index([companyId], map: "users_company_id_fkey")
  @@map("users")
}
