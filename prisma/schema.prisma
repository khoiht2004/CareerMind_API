generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique @map("email")
  password              String           @map("password")
  role                  Role             @default(CANDIDATE) @map("role")
  isVerified            Boolean          @default(false) @map("is_verified")
  isActive              Boolean          @default(true) @map("is_active")
  verificationCode      String?          @map("verification_code") @db.VarChar(6)
  verificationCodeExpAt DateTime?        @map("verification_code_exp_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  companyId             String?          @map("company_id")
  canCompanyManage      Boolean          @default(false) @map("can_company_manage")
  applications          Application[]
  chatSessions          ChatSession[]
  coverLetters          CoverLetter[]
  cvs                   Cv[]
  postedJobs            Job[]
  profile               Profile?
  refreshTokens         RefreshToken[]
  revokedTokens         RevokedToken[]
  savedJobs             SavedJob[]
  companyReviews        CompanyReview[]
  company               Company?         @relation(fields: [companyId], references: [id])
  userPermissions       UserPermission[]

  @@index([companyId], map: "users_company_id_fkey")
  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  fullName  String?  @map("full_name")
  phone     String?  @map("phone") @db.Text
  avatarUrl String?  @map("avatar_url")
  bio       String?  @map("bio") @db.Text
  subBio    String?  @map("sub_bio") @db.Text
  address   String?  @map("address")
  skills    Json?    @map("skills")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Job {
  id           String        @id @default(uuid())
  title        String        @map("title")
  location     String        @map("location")
  salary       String?       @map("salary")
  type         JobType       @default(FULL_TIME) @map("type")
  level        String?       @map("level")
  description  String        @map("description") @db.LongText
  tags         Json?         @map("tags")
  industry     Json?         @map("industry")
  benefits     Json?         @map("benefits")
  requirements Json?         @map("requirements")
  slots        Int           @default(1) @map("slots")
  deadline     DateTime?     @map("deadline")
  status       JobStatus     @default(PUBLISHED) @map("status")
  isHot        Boolean       @default(false) @map("is_hot")
  viewCount    Int           @default(0) @map("view_count")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  postedById   String        @map("posted_by_id")
  companyId    String        @map("company_id")
  applications Application[]
  cvAnalyses   CvAnalysis[]
  company      Company       @relation(fields: [companyId], references: [id])
  postedBy     User          @relation(fields: [postedById], references: [id], onDelete: Cascade)
  savedBy      SavedJob[]

  @@index([postedById])
  @@index([companyId], map: "jobs_company_id_fkey")
  @@map("jobs")
}

model Company {
  id                String        @id @default(uuid())
  name              String        @map("name")
  email             String        @map("email")
  phone             String?       @map("phone")
  description       String?       @map("description") @db.Text
  subDescription    String?       @map("sub_description") @db.Text
  address           String?       @map("address") @db.VarChar(255)
  industry          String?       @map("industry") @db.VarChar(100)
  size              String?       @map("size") @db.VarChar(100)
  mapUrl            String?       @map("map_url") @db.Text
  logoUrl           String?       @map("logo_url") @db.Text
  coverImageUrl     String?       @map("cover_image_url") @db.Text
  socialLinks       Json?         @map("social_links")
  isVerified        Boolean       @default(false) @map("is_verified")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  totalJobs         Int           @default(0) @map("total_jobs")
  totalApplications Int           @default(0) @map("total_applications")
  applications      Application[]
  reviews           CompanyReview[]
  jobs              Job[]
  user              User[]

  @@map("companies")
}

model CompanyReview {
  id        String   @id @default(uuid())
  rating    Int      @map("rating")
  comment   String?  @map("comment") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@map("company_reviews")
}

model Application {
  id                String            @id @default(uuid())
  coverLetter       String?           @map("cover_letter") @db.Text
  cvUrl             String?           @map("cv_url")
  status            ApplicationStatus? @default(PENDING) @map("status")
  note              String?           @map("note") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  userId            String            @map("user_id")
  jobId             String            @map("job_id")
  phone             String?           @map("phone")
  confirmDeadline   DateTime?         @map("confirm_deadline")
  interviewDate     DateTime?         @map("interview_date")
  interviewFormat   String?           @map("interview_format") @db.VarChar(20)
  interviewLocation String?           @map("interview_location") @db.VarChar(500)
  interviewTime     String?           @map("interview_time") @db.VarChar(10)
  officeAddress     String?           @map("office_address") @db.VarChar(500)
  startDate         DateTime?         @map("start_date")
  startTime         String?           @map("start_time") @db.VarChar(10)
  cvId              String?           @map("cv_id")
  companyId         String?
  isDraft           Boolean           @default(false) @map("is_draft")
  company           Company?          @relation(fields: [companyId], references: [id])
  cv                Cv?               @relation(fields: [cvId], references: [id])
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([cvId])
  @@index([companyId], map: "applications_companyId_fkey")
  @@map("applications")
}

model SavedJob {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

model Cv {
  id           String        @id @default(uuid())
  name         String        @map("name")
  fileUrl      String        @map("file_url")
  isDefault    Boolean       @default(false) @map("is_default")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  userId       String        @map("user_id")
  fileSize     Int?          @map("file_size")
  fileType     String?       @map("file_type") @db.VarChar(10)
  applications Application[]
  cvAnalyses   CvAnalysis[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cvs")
}

model CoverLetter {
  id        String   @id @default(uuid())
  title     String   @map("title")
  content   String   @map("content") @db.LongText
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cover_letters")
}

model CvTemplate {
  id          String   @id @default(uuid())
  title       String   @map("title")
  industry    String?  @map("industry") @db.VarChar(100)
  level       String?  @map("level") @db.VarChar(50)
  content     String   @map("content") @db.LongText
  previewUrl  String?  @map("preview_url") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cv_templates")
}

model CoverLetterTemplate {
  id          String   @id @default(uuid())
  title       String   @map("title")
  industry    String?  @map("industry") @db.VarChar(100)
  level       String?  @map("level") @db.VarChar(50)
  content     String   @map("content") @db.LongText
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cover_letter_templates")
}

model Post {
  id          String   @id @default(uuid())
  title       String   @map("title")
  slug        String?  @unique @map("slug")
  excerpt     String?  @map("excerpt") @db.Text
  content     String   @map("content") @db.LongText
  coverUrl    String?  @map("cover_url") @db.Text
  category    String?  @map("category") @db.VarChar(100)
  authorName  String?  @map("author_name") @db.VarChar(120)
  isPublished Boolean  @default(true) @map("is_published")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("posts")
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String?       @map("title")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  userId    String        @map("user_id")
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String      @id @default(uuid())
  role        MessageRole @map("role")
  content     String      @map("content") @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  sessionId   String      @map("session_id")
  messageType MessageType @default(TEXT) @map("message_type")
  attachments Json?       @map("attachments")
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cvAnalysis  CvAnalysis?

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model CvAnalysis {
  id           String      @id @default(uuid())
  score        Int         @map("score")
  strengths    Json        @map("strengths")
  weaknesses   Json        @map("weaknesses")
  improvements Json        @map("improvements")
  summary      String      @map("summary") @db.Text
  rawCvText    String?     @map("raw_cv_text") @db.LongText
  createdAt    DateTime    @default(now()) @map("created_at")
  messageId    String      @unique @map("message_id")
  jobId        String?     @map("job_id")
  cvId         String?     @map("cv_id")
  cv           Cv?         @relation(fields: [cvId], references: [id])
  job          Job?        @relation(fields: [jobId], references: [id])
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([cvId])
  @@map("cv_analyses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @map("token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @map("token") @db.Text
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("revoked_tokens")
}

model Queue {
  id         Int      @id @default(autoincrement())
  type       String   @map("type") @db.VarChar(255)
  payload    String   @map("payload") @db.Text
  status     String   @default("pending") @map("status") @db.VarChar(255)
  isPriority Int      @default(0) @map("is_priority") @db.SmallInt
  info       String?  @map("info") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("queues")
}

enum JobType {
  FULL_TIME
  PART_TIME
  REMOTE
  INTERNSHIP
  CONTRACT
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  DRAFT
  PENDING
  REVIEWING
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageType {
  TEXT
  CV_ANALYSIS
  SYSTEM_NOTE
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

// ─── Permission Module ────────────────────────────────────────────────────────

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  group           Json
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  permissionId String     @map("permission_id")
  isGranted    Boolean    @default(true) @map("is_granted") // 
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}
