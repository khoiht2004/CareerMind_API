generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  REMOTE
  INTERNSHIP
  CONTRACT
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique @map("email")
  password              String    @map("password")
  role                  Role      @default(CANDIDATE) @map("role")
  isVerified            Boolean   @default(false) @map("is_verified")
  isActive              Boolean   @default(true) @map("is_active")
  verificationCode      String?   @map("verification_code") @db.VarChar(6)
  verificationCodeExpAt DateTime? @map("verification_code_exp_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  profile       Profile?
  chatSessions  ChatSession[]
  refreshTokens RefreshToken[]
  revokedTokens RevokedToken[]
  applications  Application[]
  cvs           Cv[]
  coverLetters  CoverLetter[]
  postedJobs    Job[]

  @@map("users")
}

// ─── Profile ──────────────────────────────────────────────────────────────────

model Profile {
  id        String   @id @default(uuid())
  fullName  String?  @map("full_name")
  phone     String?  @map("phone")
  avatarUrl String?  @map("avatar_url")
  bio       String?  @db.Text @map("bio")
  address   String?  @map("address")
  skills    String?  @db.Text @map("skills")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─── Job ──────────────────────────────────────────────────────────────────────

model Job {
  id          String    @id @default(uuid())
  title       String    @map("title")
  company     String    @map("company")
  location    String    @map("location")
  salary      String?   @map("salary")
  type        JobType   @default(FULL_TIME) @map("type")
  level       String?   @map("level")
  tags        String?   @db.Text @map("tags")
  description String    @db.LongText @map("description")
  benefits    String?   @db.Text @map("benefits")
  slots       Int       @default(1) @map("slots")
  deadline    DateTime? @map("deadline")
  status      JobStatus @default(PUBLISHED) @map("status")
  isHot       Boolean   @default(false) @map("is_hot")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  postedById   String       @map("posted_by_id")
  postedBy     User         @relation(fields: [postedById], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([postedById])
  @@map("jobs")
}

// ─── Application ──────────────────────────────────────────────────────────────

model Application {
  id          String            @id @default(uuid())
  coverLetter String?           @db.Text @map("cover_letter")
  cvUrl       String?           @map("cv_url")
  status      ApplicationStatus @default(PENDING) @map("status")
  note        String?           @db.Text @map("note")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String @map("job_id")
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("applications")
}

// ─── Cv ───────────────────────────────────────────────────────────────────────

model Cv {
  id        String   @id @default(uuid())
  name      String   @map("name")
  fileUrl   String   @map("file_url")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cvs")
}

// ─── CoverLetter ──────────────────────────────────────────────────────────────

model CoverLetter {
  id        String   @id @default(uuid())
  title     String   @map("title")
  content   String   @db.LongText @map("content")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cover_letters")
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(uuid())
  title     String?  @map("title")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId   String        @map("user_id")
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  role      MessageRole @map("role")
  content   String      @db.Text @map("content")
  createdAt DateTime    @default(now()) @map("created_at")

  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

// ─── Auth tokens ──────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @map("token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @db.Text @map("token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("revoked_tokens")
}

// ─── System ───────────────────────────────────────────────────────────────────

model Queue {
  id         Int      @id @default(autoincrement())
  type       String?  @map("type") @db.VarChar(255)
  payload    String?  @db.Text @map("payload")
  status     String   @default("pending") @map("status") @db.VarChar(255)
  isPriority Int      @default(0) @map("is_priority") @db.SmallInt
  info       String?  @db.Text @map("info")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("queues")
}
